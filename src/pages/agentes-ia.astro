---
import CardGrid from "../components/CardGrid.astro";
import ContactSection from "../components/ContactSection.astro";
import { landingConfig } from "../config/landing";
import BaseLayout from "../layouts/BaseLayout.astro";

const capabilityCards = [
  {
    tag: "Integración",
    title: "Usa herramientas reales de la operación",
    detail: "Correo, CRM, ERP, planillas, bases de datos o software interno. La solución debe integrarse al proceso real, no funcionar como una pieza aislada.",
  },
  {
    tag: "Contexto",
    title: "Trabaja con información útil del negocio",
    detail: "Documentos, manuales, procesos y datos internos quedan ordenados para preparar trabajo, responder consultas o ejecutar pasos con mejor criterio.",
  },
  {
    tag: "Control",
    title: "Deja trazabilidad y puntos de revisión",
    detail: "El equipo sabe qué ocurrió, qué información se usó, qué está pendiente y cuándo una acción sensible requiere aprobación.",
  },
];
---

<BaseLayout
  titleKey="meta.tools.title"
  descriptionKey="meta.tools.description"
  currentPath="/agentes-ia"
>
  <main class="page-main">
    <section class="section page-intro-section">
      <div class="section-intro">
        <p class="eyebrow">Soluciones</p>
        <h1 class="page-title">Soluciones digitales para ordenar procesos y mejorar la ejecución diaria</h1>
        <p>
          Diseñamos flujos, integraciones y sistemas simples para que tareas repetitivas tengan responsables, estados,
          seguimiento y resultados verificables.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="section-intro">
        <p class="eyebrow">Qué resuelve</p>
        <h2>Dónde tiene sentido construir una solución digital</h2>
        <p>
          Sirve cuando una tarea se repite, cruza información, exige usar varias herramientas y necesita más velocidad
          sin perder control operativo.
        </p>
      </div>
      <CardGrid items={capabilityCards} gridClass="step-grid" cardClass="step-card" />
    </section>

    <section class="section system-section">
      <div class="section-intro">
        <p class="eyebrow">Diferencia comercial</p>
        <h2>No partimos por la herramienta. Partimos por el proceso.</h2>
        <p>
          El valor está en entender el flujo, definir responsables, conectar herramientas y dejar seguimiento visible para
          que la operación avance con menos fricción.
        </p>
      </div>
      <div class="scope-clarity-grid">
        <article class="scope-clarity-card">
          <h3>Lo que sí hacemos</h3>
          <ul>
            <li>Conectar una tarea concreta con una herramienta real</li>
            <li>Dejar contexto, reglas y trazabilidad</li>
            <li>Definir aprobación y responsables para acciones críticas</li>
          </ul>
        </article>
        <article class="scope-clarity-card is-limited">
          <h3>Lo que no prometemos</h3>
          <ul>
            <li>Automatizar decisiones críticas sin criterio claro</li>
            <li>Arquitectura compleja por moda</li>
            <li>Reemplazo total de personas</li>
          </ul>
        </article>
      </div>
    </section>

    <ContactSection
      config={landingConfig}
      source="automize-solutions"
      offer="soluciones-digitales"
      compactOnMobile={true}
    />
  </main>
</BaseLayout>
