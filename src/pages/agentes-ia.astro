---
import CardGrid from "../components/CardGrid.astro";
import ContactSection from "../components/ContactSection.astro";
import { landingConfig } from "../config/landing";
import BaseLayout from "../layouts/BaseLayout.astro";

const capabilityCards = [
  {
    tag: "Integración",
    title: "Usa herramientas reales de la operación",
    detail: "Correo, CRM, ERP, planillas, bases de datos o software interno. La IA sirve cuando puede actuar sobre el proceso, no solo conversar.",
  },
  {
    tag: "Memoria",
    title: "Trabaja con contexto útil del negocio",
    detail: "Puede consultar manuales, procesos, documentos y datos internos antes de responder, preparar información o ejecutar un paso.",
  },
  {
    tag: "Control",
    title: "Deja trazabilidad y puntos de revisión",
    detail: "Usted sabe qué hizo, con qué información trabajó y cuándo pidió aprobación humana en una acción sensible.",
  },
];
---

<BaseLayout
  titleKey="meta.tools.title"
  descriptionKey="meta.tools.description"
  currentPath="/agentes-ia"
>
  <main class="page-main">
    <section class="section page-intro-section">
      <div class="section-intro">
        <p class="eyebrow">Agentes de IA</p>
        <h1 class="page-title">IA que no solo responde: ejecuta procesos bajo supervisión</h1>
        <p>
          Un agente de IA no es solo un chatbot. Es un sistema que puede analizar información, usar herramientas,
          recordar contexto relevante y ejecutar pasos dentro de un proceso bajo reglas de control.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="section-intro">
        <p class="eyebrow">Qué resuelve</p>
        <h2>Dónde sí tiene sentido usar un agente</h2>
        <p>
          Sirve cuando una tarea se repite, cruza información, exige usar varias herramientas y necesita más velocidad
          sin perder control operativo.
        </p>
      </div>
      <CardGrid items={capabilityCards} gridClass="step-grid" cardClass="step-card" />
    </section>

    <section class="section system-section">
      <div class="section-intro">
        <p class="eyebrow">Diferencia comercial</p>
        <h2>No instalamos chats. Construimos sistemas de ejecución.</h2>
        <p>
          La utilidad de la IA no se mide por lo bien que conversa, sino por las herramientas que puede usar y por los
          procesos que puede mejorar con seguridad.
        </p>
      </div>
      <div class="scope-clarity-grid">
        <article class="scope-clarity-card">
          <h3>Lo que sí hacemos</h3>
          <ul>
            <li>Conectar una tarea concreta con una herramienta real</li>
            <li>Dejar contexto, reglas y trazabilidad</li>
            <li>Pedir aprobación humana antes de acciones críticas</li>
          </ul>
        </article>
        <article class="scope-clarity-card is-limited">
          <h3>Lo que no prometemos</h3>
          <ul>
            <li>Autonomía total cuando el proceso requiere control</li>
            <li>Arquitectura compleja por moda</li>
            <li>Reemplazo total de personas</li>
          </ul>
        </article>
      </div>
    </section>

    <ContactSection
      config={landingConfig}
      source="automize-agents"
      offer="piloto-agente-operativo"
      compactOnMobile={true}
    />
  </main>
</BaseLayout>
