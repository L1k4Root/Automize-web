---
import CardGrid from "../components/CardGrid.astro";
import ContactSection from "../components/ContactSection.astro";
import SectionIntro from "../components/SectionIntro.astro";
import { landingConfig } from "../config/landing";
import { integrationLogos } from "../data/automize";
import BaseLayout from "../layouts/BaseLayout.astro";

const integrationLoop = [...integrationLogos, ...integrationLogos];
const toolCards = [
  {
    i18nKey: "tools.capture",
    tag: "Entrada",
    title: "Trabajamos sobre el canal donde hoy nace la tarea",
    detail: "WhatsApp, formularios, correo o planillas pueden ser el punto de entrada si ese es tu proceso real.",
  },
  {
    i18nKey: "tools.board",
    tag: "Registro",
    title: "Dejamos estado visible y responsable asignado",
    detail: "La herramienta importa menos que el criterio operativo: quién toma el caso, qué falta y qué viene después.",
  },
  {
    i18nKey: "tools.orchestration",
    tag: "Automatización",
    title: "Usamos la capa de automatización que haga falta, no más",
    detail: "Si una regla simple y un flujo acotado resuelven el problema, no hace falta introducir arquitectura extra.",
  },
  {
    i18nKey: "tools.ai",
    tag: "IA",
    title: "La IA se usa con límites concretos",
    detail: "Clasificar, resumir, extraer o preparar información puede ayudar. Decisiones sensibles o ambiguas vuelven a revisión humana.",
  },
];
---

<BaseLayout
  titleKey="meta.tools.title"
  descriptionKey="meta.tools.description"
  currentPath="/herramientas"
>
  <main class="page-main">
    <section class="section page-intro-section">
      <SectionIntro
        eyebrow="Herramientas"
        eyebrowKey="tools.eyebrow"
        title="Las herramientas son medios para operar mejor, no la promesa principal"
        titleKey="tools.title"
        body="Esta página explica con qué solemos trabajar y cómo elegimos cada pieza según el proceso, sin convertir el stack en el centro de la venta."
        bodyKey="tools.body"
      />
    </section>

    <section class="integration-strip" aria-label="Conectamos las herramientas que tu equipo ya usa" data-i18n-aria-label="integrations.label">
      <div class="integration-copy">
        <p class="eyebrow" data-i18n="integrations.label">Herramientas</p>
        <h2 data-i18n="integrations.title">Conectamos lo que ya usas. Elegimos la herramienta según el proceso</h2>
        <p class="integration-mobile-copy" data-i18n="tools.stack.body">
          WhatsApp, planillas, correo, CRM o Notion: partimos desde lo que ya existe y agregamos complejidad solo cuando aporta.
        </p>
      </div>
      <div class="integration-carousel" aria-hidden="true">
        <div class="integration-track">
          {
            integrationLoop.map((logo) => (
              <span class={`integration-logo ${logo.tone}`}>
                <span class="integration-logo-mark">
                  {
                    logo.logoUrl ? (
                      <img
                        src={logo.logoUrl}
                        alt={logo.logoAlt ?? logo.name}
                        loading="lazy"
                        decoding="async"
                        width="28"
                        height="28"
                      />
                    ) : (
                      <strong>{logo.mark}</strong>
                    )
                  }
                </span>
                <em>{logo.name}</em>
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-intro">
        <p class="eyebrow" data-i18n="tools.layers.eyebrow">Cómo elegimos</p>
        <h2 data-i18n="tools.layers.title">La herramienta sigue al proceso</h2>
        <p data-i18n="tools.layers.body">
          No partimos por un stack ideal. Partimos por la tarea, el riesgo, el volumen y el punto donde hoy se pierde control.
        </p>
      </div>
      <CardGrid items={toolCards} gridClass="step-grid" cardClass="step-card" />
    </section>

    <ContactSection
      config={landingConfig}
      source="automize-tools"
      offer="workflow-tooling"
      compactOnMobile={true}
    />
  </main>
</BaseLayout>
