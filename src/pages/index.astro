---
import CardGrid from "../components/CardGrid.astro";
import ContactSection from "../components/ContactSection.astro";
import FaqList from "../components/FaqList.astro";
import { landingConfig } from "../config/landing";
import { heroFlowSteps, heroSignals, problemFlow } from "../data/automize";
import BaseLayout from "../layouts/BaseLayout.astro";

const solutionBlocks = [
  {
    tag: "01",
    badge: "Piloto acotado",
    title: "Agente operativo",
    detail: "Automatiza una tarea concreta usando correo, CRM, planillas o sistemas internos, con supervisión cuando hace falta.",
    result: "Una integración clara y un resultado verificable",
  },
  {
    tag: "02",
    badge: "Contexto útil",
    title: "Memoria corporativa inteligente",
    detail: "La IA consulta documentos, manuales, procesos y datos internos para responder o preparar trabajo con mejor contexto.",
    result: "Menos búsqueda manual y respuestas más consistentes",
  },
  {
    tag: "03",
    badge: "Control operativo",
    title: "Auditoría y blindaje de IA",
    detail: "Revisamos confiabilidad, errores, trazabilidad, seguridad y costos en sistemas de IA que ya están en uso.",
    result: "Más control antes de escalar automatizaciones",
  },
];

const featuredCases = [
  {
    question: "Triaje de leads",
    answer: "Clasifica contactos entrantes, prioriza oportunidades y deja listo el siguiente paso comercial.",
  },
  {
    question: "Agente de facturación",
    answer: "Revisa correos, extrae datos y prepara registros para contabilidad con validación humana final.",
  },
  {
    question: "Soporte con memoria",
    answer: "Responde preguntas usando documentación interna validada y contexto relevante del negocio.",
  },
];

const shortFaqs = [
  {
    question: "¿Esto reemplaza personas?",
    answer: "No. Reduce trabajo repetitivo y deja a las personas en decisiones donde hace falta criterio.",
  },
  {
    question: "¿Necesito cambiar mis sistemas?",
    answer: "No. Partimos desde lo que ya usa su operación y agregamos complejidad solo cuando aporta valor.",
  },
  {
    question: "¿La IA puede actuar sola?",
    answer: "Solo cuando el riesgo lo permite. En acciones sensibles dejamos aprobación humana o límites claros.",
  },
];

const methodBlocks = [
  {
    title: "Una tarea concreta",
    detail: "Elegimos un proceso repetitivo con impacto visible en vez de partir con una solución demasiado amplia.",
  },
  {
    title: "Una integración clara",
    detail: "Conectamos la herramienta que realmente mueve el proceso: correo, CRM, planilla o sistema interno.",
  },
  {
    title: "Un resultado verificable",
    detail: "Probamos, medimos y ajustamos antes de ampliar alcance o complejidad.",
  },
];
---

<BaseLayout
  titleKey="meta.title"
  descriptionKey="meta.description"
  currentPath="/"
  ctaHref="#contacto"
  footerContactHref="#contacto"
>
  <main>
    <section id="home" class="hero automize-hero">
      <div class="automate-visual" aria-label="Mapa visual del proceso, estados y alertas" data-i18n-aria-label="hero.visualLabel">
        <img class="automation-emblem" src="/automize-icon.png" alt="" width="220" height="220" />
        <div class="flow-map">
          <span
            class="flow-node node-input"
            aria-label="Entrada: datos, formularios, correos, planillas o eventos que inician el flujo"
            tabindex="0"
            data-tooltip="Datos, formularios, correos, planillas o eventos que inician el flujo"
            data-i18n="hero.node.input"
            data-i18n-aria-label="hero.node.inputLabel"
            data-i18n-tooltip="hero.node.inputTooltip">Entrada</span
          >
          <span class="flow-line line-one"></span>
          <span
            class="flow-node node-decision"
            aria-label="Reglas: validación, clasificación o revisión humana según el riesgo"
            tabindex="0"
            data-tooltip="Validación, clasificación o revisión humana según el riesgo"
            data-i18n="hero.node.decision"
            data-i18n-aria-label="hero.node.decisionLabel"
            data-i18n-tooltip="hero.node.decisionTooltip">Reglas</span
          >
          <span class="flow-line line-two"></span>
          <span
            class="flow-node node-output"
            aria-label="Salida lista: CRM actualizado, alerta enviada, reporte creado o tarea asignada"
            tabindex="0"
            data-tooltip="CRM actualizado, alerta enviada, reporte creado o tarea asignada"
            data-i18n="hero.node.output"
            data-i18n-aria-label="hero.node.outputLabel"
            data-i18n-tooltip="hero.node.outputTooltip">Salida lista</span
          >
          <span class="flow-branch branch-alert"></span>
          <span
            class="flow-node node-review"
            aria-label="Revisión: control humano para errores, datos incompletos o decisiones sensibles"
            tabindex="0"
            data-tooltip="Control humano para errores, datos incompletos o decisiones sensibles"
            data-i18n="hero.node.review"
            data-i18n-aria-label="hero.node.reviewLabel"
            data-i18n-tooltip="hero.node.reviewTooltip">Revisión</span
          >
        </div>
        <div class="signal-stack">
          {
            heroSignals.map((signal) => (
              <div class={`automation-signal ${signal.tone}`}>
                <span data-i18n={signal.i18nKey ? `${signal.i18nKey}.label` : undefined}>{signal.label}</span>
                <strong data-i18n={signal.i18nKey ? `${signal.i18nKey}.value` : undefined}>{signal.value}</strong>
              </div>
            ))
          }
        </div>
      </div>

      <div class="hero-content automize-hero-content">
        <p class="eyebrow">Automatización operativa con IA</p>
        <h1>IA que no solo responde: ejecuta procesos bajo supervisión</h1>
        <p class="hero-subtitle">
          Conectamos correo, CRM, planillas y sistemas internos para reducir trabajo manual, mejorar seguimiento y dejar trazabilidad en procesos repetitivos.
        </p>
        <div class="hero-mobile-flow" aria-label="Ruta del diagnóstico">
          {
            heroFlowSteps.map((step, index) => (
              <article class="hero-mobile-step">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{step.title}</strong>
                <p>{step.detail}</p>
              </article>
            ))
          }
        </div>
        <div class="hero-actions" aria-label="Acciones principales">
          <a class="button button-primary" href="/diagnostico#contacto" data-track-click="automize_home_diagnostic_cta">
            Solicitar diagnóstico
          </a>
          <a class="button button-secondary" href="/casos-de-uso" data-track-click="automize_home_cases_cta">
            Ver casos de uso
          </a>
        </div>
        <p class="hero-commitment">Menos trabajo manual. Más seguimiento. Más control sobre la operación.</p>
        <div class="premium-strip" aria-label="Oferta resumida">
          <div class="premium-strip-header">
            <span>Propuesta de valor</span>
            <strong>Convertimos procesos repetitivos en flujos asistidos por IA, conectados a sus herramientas actuales</strong>
            <em>Con trazabilidad, control y criterio operativo</em>
          </div>
          <ul class="premium-strip-points" aria-label="Puntos clave de la propuesta">
            <li>No instalamos chats genéricos</li>
            <li>Partimos con una tarea concreta y una integración clara</li>
            <li>La supervisión humana se usa como seguridad, no como parche</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section section-tight">
      <div class="section-intro">
        <p class="eyebrow">Problema principal</p>
        <h2>El problema no es solo hacer tareas a mano. Es perder tiempo, seguimiento y visibilidad.</h2>
        <p>
          Cuando un proceso depende de copiar datos, revisar correos, perseguir aprobaciones o recordar el siguiente paso,
          aparecen atrasos, errores repetitivos y estados invisibles.
        </p>
      </div>
      <div class="problem-flow" aria-label="Explicación visual del problema operativo">
        {
          problemFlow.map((item, index) => (
            <article class={`problem-flow-step ${item.tone}`}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{item.label}</h3>
                <p>{item.detail}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section services-section services-preview-section">
      <div class="services-header">
        <p class="eyebrow">Bloques de solución</p>
        <h2>No vendemos IA en abstracto. Diseñamos sistemas de ejecución con control.</h2>
        <p>
          La IA útil no es la que impresiona en una demo, sino la que reduce carga operativa sin perder control.
        </p>
      </div>
      <div class="service-catalog">
        {
          solutionBlocks.map((service, index) => (
            <article class={`service-card service-card-${index + 1}`}>
              <div class="service-card-topline">
                <span>{service.tag}</span>
                <em class="service-badge">{service.badge}</em>
              </div>
              <h3>{service.title}</h3>
              <p>{service.detail}</p>
              <strong>{service.result}</strong>
            </article>
          ))
        }
      </div>
      <div class="section-cta section-cta-compact">
        <p>Revise las ofertas concretas y vea dónde conviene partir según el tipo de proceso.</p>
        <div class="section-cta-actions">
          <a class="button button-primary" href="/servicios" data-track-click="automize_home_services_cta">
            Ver servicios
          </a>
        </div>
      </div>
    </section>

    <section class="section use-cases-section">
      <div class="section-intro">
        <p class="eyebrow">Casos destacados</p>
        <h2>Procesos donde la IA sí aporta valor operativo</h2>
        <p>No prometemos autonomía total. Diseñamos automatización incremental para tareas reales de negocio.</p>
      </div>
      <div class="faq-list">
        <FaqList items={featuredCases} />
      </div>
      <div class="section-cta section-cta-compact">
        <p>Si su operación se parece a uno de estos casos, vale la pena revisar la biblioteca completa.</p>
        <div class="section-cta-actions">
          <a class="button button-primary" href="/casos-de-uso" data-track-click="automize_home_cases_library_cta">
            Ver casos de uso
          </a>
        </div>
      </div>
    </section>

    <section class="section method-section method-preview-section">
      <div class="section-intro">
        <p class="eyebrow">Cómo partimos</p>
        <h2>Start simple, iterate fast</h2>
        <p>La sofisticación debe nacer de la necesidad, no del hype.</p>
      </div>
      <CardGrid items={methodBlocks} gridClass="step-grid" cardClass="step-card" />
      <div class="section-cta section-cta-compact">
        <p>Primero definimos el piloto. Después medimos trazabilidad, errores y valor real antes de escalar.</p>
        <div class="section-cta-actions">
          <a class="button button-secondary" href="/como-trabajamos" data-track-click="automize_home_method_cta">
            Cómo trabajamos
          </a>
        </div>
      </div>
    </section>

    <section class="section faq-section faq-preview-section" aria-label="Preguntas frecuentes sobre Automize">
      <div class="section-intro">
        <p class="eyebrow">FAQ breve</p>
        <h2>Objeciones normales antes de pedir diagnóstico</h2>
        <p>Respondemos primero lo que más pesa en una decisión de negocio.</p>
      </div>
      <FaqList items={shortFaqs} />
      <div class="section-cta section-cta-compact">
        <p>Si necesita revisar objeciones más específicas sobre control, costo o adopción, la FAQ completa quedó separada.</p>
        <div class="section-cta-actions">
          <a class="button button-secondary" href="/faq" data-track-click="automize_home_faq_cta">
            Ver FAQ completa
          </a>
        </div>
      </div>
    </section>

    <ContactSection
      config={landingConfig}
      source="automize-home"
      offer="diagnostico-operativo"
      compactOnMobile={true}
    />
  </main>
</BaseLayout>
