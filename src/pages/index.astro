---
import CardGrid from "../components/CardGrid.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import LeadForm from "../components/LeadForm.astro";
import { landingConfig } from "../config/landing";
import {
  heroFlowSteps,
  heroSignals,
  impactProofs,
  integrationLogos,
  methodSteps,
  problemFlow,
  principles,
  problems,
  services,
  systemSteps,
} from "../data/automize";
import { languageCopy } from "../data/i18n";
import "../styles/global.css";

const metadata = {
  title: languageCopy.es["meta.title"],
  description: languageCopy.es["meta.description"],
};
const integrationLoop = [...integrationLogos, ...integrationLogos];
const languagePayload = JSON.stringify(languageCopy).replace(/</g, "\\u003c");
const headerCtaKey = landingConfig.isLeadCaptureConfigured ? "cta.headerConfigured" : "cta.headerUnconfigured";
const headerCtaLabel = landingConfig.isLeadCaptureConfigured
  ? languageCopy.es["cta.headerConfigured"]
  : languageCopy.es["cta.headerUnconfigured"];
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={metadata.description}
      data-i18n-content="meta.description"
    />
    <link rel="icon" type="image/png" href="/automize-icon.png" />
    <link rel="apple-touch-icon" href="/automize-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={metadata.description} data-i18n-content="meta.description" />
    <meta property="og:image" content="/automize-icon.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={metadata.description} data-i18n-content="meta.description" />
    <meta name="theme-color" content="#07110f" />
    <title>{metadata.title}</title>
  </head>
  <body class="automize-page">
    <header class="site-header automize-header" data-nav>
      <a class="brand" href="#home" aria-label="Automize">
        <img class="brand-mark" src="/automize-icon.png" alt="" width="48" height="48" />
        <span class="brand-copy">
          <strong>Automize</strong>
          <small data-i18n="brand.subtitle">Diagnostico de automatizacion</small>
        </span>
      </a>
      <nav class="nav-links" aria-label="Navegacion principal" data-i18n-aria-label="nav.label">
        <a href="#problema" data-i18n="nav.problem">Problema</a>
        <a href="#servicios" data-i18n="nav.services">Servicios</a>
        <a href="#metodo" data-i18n="nav.method">Metodo</a>
        <a href="#contacto" data-i18n="nav.contact">Contacto</a>
      </nav>
      <div class="header-actions">
        <LanguageSwitch />
        <a class="header-cta" href="#contacto" data-track-click="automize_header_cta" data-i18n={headerCtaKey}>
          {headerCtaLabel}
        </a>
      </div>
    </header>

    <main>
      <section id="home" class="hero automize-hero">
        <div class="automate-visual" aria-label="Mapa visual del problema operativo y su automatizacion" data-i18n-aria-label="hero.visualLabel">
          <img class="automation-emblem" src="/automize-icon.png" alt="" width="220" height="220" />
          <div class="flow-map">
            <span
              class="flow-node node-input"
              aria-label="Entrada manual: datos, formularios, correos, planillas o eventos que inician el flujo"
              tabindex="0"
              data-tooltip="Datos, formularios, correos, planillas o eventos que inician el flujo"
              data-i18n="hero.node.input"
              data-i18n-aria-label="hero.node.inputLabel"
              data-i18n-tooltip="hero.node.inputTooltip">Entrada manual</span
            >
            <span class="flow-line line-one"></span>
            <span
              class="flow-node node-decision"
              aria-label="Reglas e IA: validacion, clasificacion o revision humana segun el riesgo"
              tabindex="0"
              data-tooltip="Reglas, IA o revision humana segun el riesgo"
              data-i18n="hero.node.decision"
              data-i18n-aria-label="hero.node.decisionLabel"
              data-i18n-tooltip="hero.node.decisionTooltip">Reglas e IA</span
            >
            <span class="flow-line line-two"></span>
            <span
              class="flow-node node-output"
              aria-label="Salida lista: CRM actualizado, alerta enviada, reporte creado o tarea asignada"
              tabindex="0"
              data-tooltip="CRM actualizado, alerta enviada, reporte creado o tarea asignada"
              data-i18n="hero.node.output"
              data-i18n-aria-label="hero.node.outputLabel"
              data-i18n-tooltip="hero.node.outputTooltip">Salida lista</span
            >
            <span class="flow-branch branch-alert"></span>
            <span
              class="flow-node node-review"
              aria-label="Excepcion: control humano para errores, datos incompletos o decisiones sensibles"
              tabindex="0"
              data-tooltip="Control humano para excepciones, errores o decisiones sensibles"
              data-i18n="hero.node.review"
              data-i18n-aria-label="hero.node.reviewLabel"
              data-i18n-tooltip="hero.node.reviewTooltip">Excepcion</span
            >
          </div>
          <div class="signal-stack">
            {
              heroSignals.map((signal) => (
                <div class={`automation-signal ${signal.tone}`}>
                  <span data-i18n={signal.i18nKey ? `${signal.i18nKey}.label` : undefined}>{signal.label}</span>
                  <strong data-i18n={signal.i18nKey ? `${signal.i18nKey}.value` : undefined}>{signal.value}</strong>
                </div>
              ))
            }
          </div>
        </div>

        <div class="hero-content automize-hero-content">
          <p class="eyebrow" data-i18n="hero.eyebrow">Automatizacion de procesos con IA</p>
          <h1 data-i18n="hero.title">Automatiza el trabajo repetido sin perder control</h1>
          <p class="hero-subtitle" data-i18n="hero.subtitle">
            Convertimos solicitudes, aprobaciones, reportes y seguimientos manuales en flujos con responsables, estados
            visibles y alertas accionables.
          </p>
          <div class="hero-mobile-flow" aria-label="Ruta del diagnostico" data-i18n-aria-label="hero.mobileFlowLabel">
            {
              heroFlowSteps.map((step, index) => (
                <article class="hero-mobile-step">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <strong data-i18n={step.i18nKey ? `${step.i18nKey}.title` : undefined}>{step.title}</strong>
                  <p data-i18n={step.i18nKey ? `${step.i18nKey}.detail` : undefined}>{step.detail}</p>
                </article>
              ))
            }
          </div>
          <div class="hero-actions" aria-label="Acciones principales">
            <a class="button button-primary" href="#contacto" data-track-click="automize_lead_cta" data-i18n="hero.primaryCta">
              Diagnosticar mi proceso
            </a>
            <a class="button button-secondary" href="#servicios" data-track-click="automize_services_cta" data-i18n="hero.secondaryCta">
              Ver que automatizamos
            </a>
          </div>
          <p class="hero-commitment" data-i18n="hero.commitment">
            Primer paso: detectar el flujo con mayor retorno antes de construir
          </p>
          <div class="premium-strip" aria-label="Oferta resumida">
            <div class="premium-strip-header">
              <span data-i18n="hero.offerLabel">Oferta inicial</span>
              <strong data-i18n="hero.offerDetail">Diagnostico + mapa + plan de implementacion</strong>
              <em data-i18n="hero.offerPrice">Desde USD 900</em>
            </div>
            <ul class="premium-strip-points" aria-label="Entregables de la oferta">
              <li data-i18n="hero.offerPoint.scope">1 proceso critico priorizado</li>
              <li data-i18n="hero.offerPoint.output">Mapa de flujo, riesgos y quick wins</li>
              <li data-i18n="hero.offerPoint.discount">Descontable si pasamos a implementacion</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="integration-strip" aria-label="Apps con las que trabajamos">
        <div class="integration-copy">
          <p class="eyebrow" data-i18n="integrations.label">Apps con las que trabajamos</p>
          <h2 data-i18n="integrations.title">Conectamos tus herramientas operativas y usamos IA donde agrega control</h2>
        </div>
        <div class="integration-carousel" aria-hidden="true">
          <div class="integration-track">
            {
              integrationLoop.map((logo) => (
                <span class={`integration-logo ${logo.tone}`}>
                  <span class="integration-logo-mark">
                    {
                      logo.logoUrl ? (
                        <img
                          src={logo.logoUrl}
                          alt={logo.logoAlt ?? logo.name}
                          loading="lazy"
                          decoding="async"
                          width="28"
                          height="28"
                        />
                      ) : (
                        <strong>{logo.mark}</strong>
                      )
                    }
                  </span>
                  <em>{logo.name}</em>
                </span>
              ))
            }
          </div>
        </div>
      </section>

      <section id="problema" class="section section-tight">
        <div class="section-intro">
          <p class="eyebrow" data-i18n="problems.eyebrow">Problemas que resolvemos</p>
          <h2 data-i18n="problems.title">El problema no es solo hacerlo manual: es operar sin visibilidad</h2>
          <p>
            <strong class="brand-inline" data-i18n="problems.bodyPrefix">Automize</strong>{" "}
            <span data-i18n="problems.body">muestra donde se pierde seguimiento, responsable o estado, y convierte ese trabajo repetido en un flujo controlado.</span>
          </p>
        </div>
        <div class="problem-flow" aria-label="Explicacion visual del problema operativo" data-i18n-aria-label="problems.visualLabel">
          {
            problemFlow.map((item, index) => (
              <article class={`problem-flow-step ${item.tone}`}>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3 data-i18n={item.i18nKey ? `${item.i18nKey}.label` : undefined}>{item.label}</h3>
                  <p data-i18n={item.i18nKey ? `${item.i18nKey}.detail` : undefined}>{item.detail}</p>
                </div>
              </article>
            ))
          }
        </div>
        <CardGrid
          items={problems}
          gridClass="automize-problem-grid"
          cardClass="scope-card"
          ariaLabel={languageCopy.es["problems.gridLabel"]}
          ariaLabelKey="problems.gridLabel"
        />
        <div class="section-cta">
          <p data-i18n="problems.ctaBody">Si esto pasa en tu operacion, el diagnostico aterriza el flujo exacto, el costo del problema y la primera automatizacion viable.</p>
          <a class="button button-primary" href="#contacto" data-track-click="automize_problem_cta" data-i18n="problems.cta">
            Diagnosticar mi proceso
          </a>
        </div>
      </section>

      <section class="section impact-section" aria-label="Prueba de impacto" data-i18n-aria-label="impact.label">
        <div class="section-intro">
          <p class="eyebrow" data-i18n="impact.eyebrow">Costos ocultos</p>
          <h2 data-i18n="impact.title">La perdida aparece cuando nadie ve el estado del proceso</h2>
          <p data-i18n="impact.body">
            No prometemos resultados imposibles. Buscamos tareas donde el tiempo perdido, el error o la falta de
            seguimiento hacen razonable automatizar.
          </p>
        </div>
        <div class="impact-grid">
          {
            impactProofs.map((proof) => (
              <article class="impact-card">
                <span data-i18n={proof.i18nKey ? `${proof.i18nKey}.metric` : undefined}>{proof.metric}</span>
                <h3 data-i18n={proof.i18nKey ? `${proof.i18nKey}.title` : undefined}>{proof.title}</h3>
                <p data-i18n={proof.i18nKey ? `${proof.i18nKey}.detail` : undefined}>{proof.detail}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section system-section" aria-label="Sistema Automize" data-i18n-aria-label="system.label">
        <div class="section-intro">
          <p class="eyebrow" data-i18n="system.eyebrow">Sistema Automize</p>
          <h2 data-i18n="system.title">De tarea manual a proceso operativo controlado</h2>
          <p data-i18n="system.body">
            El valor no esta en sumar mas herramientas. Esta en dejar un flujo con entrada clara, reglas, responsable,
            excepciones y registro para que el equipo pueda operarlo.
          </p>
        </div>
        <div class="system-map">
          {
            systemSteps.map((step) => (
              <article class={`system-step ${step.tone}`}>
                <span>{step.label}</span>
                <div>
                  <h3 data-i18n={step.i18nKey ? `${step.i18nKey}.title` : undefined}>{step.title}</h3>
                  <p data-i18n={step.i18nKey ? `${step.i18nKey}.detail` : undefined}>{step.detail}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section services-section">
        <span id="servicios" class="section-scroll-target" aria-hidden="true"></span>
        <div class="services-header">
          <p class="eyebrow" data-i18n="services.eyebrow">Servicios</p>
          <h2 data-i18n="services.title">Tres formas de avanzar sin sobredisenar</h2>
          <p data-i18n="services.body">
            Cada oferta tiene un momento claro: elegir bien, implementar un flujo o mantenerlo operando con soporte y
            mejoras.
          </p>
        </div>
        <div class="services-visual" aria-label="Servicios de Automize" data-i18n-aria-label="services.visualLabel">
          <div class="service-catalog">
            {
              services.map((service, index) => (
                <article class={`service-card service-card-${index + 1}`}>
                  <span>{service.tag}</span>
                  <h3 data-i18n={service.i18nKey ? `${service.i18nKey}.title` : undefined}>{service.title}</h3>
                  <p data-i18n={service.i18nKey ? `${service.i18nKey}.detail` : undefined}>{service.detail}</p>
                  {service.fit && (
                    <p class="service-fit" data-i18n={service.i18nKey ? `${service.i18nKey}.fit` : undefined}>
                      {service.fit}
                    </p>
                  )}
                  {service.includes && (
                    <ul class="service-includes" aria-label="Incluye" data-i18n-aria-label="services.includeLabel">
                      {service.includes.map((item, includeIndex) => (
                        <li data-i18n={service.i18nKey ? `${service.i18nKey}.include.${includeIndex + 1}` : undefined}>
                          {item}
                        </li>
                      ))}
                    </ul>
                  )}
                  {service.result && <strong data-i18n={service.i18nKey ? `${service.i18nKey}.result` : undefined}>{service.result}</strong>}
                </article>
              ))
            }
          </div>
          <div class="service-diagram" aria-label="Flujo de decision de servicios" data-i18n-aria-label="services.diagramLabel">
            <span class="diagram-pill" data-i18n="services.diagram.diagnostic">Diagnostico</span>
            <span class="diagram-line"></span>
            <span class="diagram-pill highlight" data-i18n="services.diagram.build">Implementacion</span>
            <span class="diagram-line danger"></span>
            <span class="diagram-pill" data-i18n="services.diagram.growth">Mejora continua</span>
            <p data-i18n="services.diagram.body">Primero elegimos bien. Luego construimos. Despues medimos, corregimos y ampliamos.</p>
          </div>
        </div>
        <div class="section-cta section-cta-compact">
          <p data-i18n="services.ctaBody">El primer paso no requiere accesos ni promesas grandes: solo elegir un proceso con dolor real y revisar si tiene sentido diagnosticarlo.</p>
          <a class="button button-primary" href="#contacto" data-track-click="automize_services_mid_cta" data-i18n="services.cta">
            Diagnosticar mi proceso
          </a>
        </div>
      </section>

      <section id="metodo" class="section method-section">
        <div class="section-intro">
          <p class="eyebrow" data-i18n="method.eyebrow">Metodo</p>
          <h2 data-i18n="method.title">Trabajamos sobre puntos criticos, rendimiento y mejora real</h2>
          <p data-i18n="method.body">
            El metodo no es llenar la empresa de automatizaciones. Es encontrar donde duele, construir algo liviano y
            optimizarlo con datos de uso.
          </p>
        </div>
        <div class="method-timeline" aria-label="Metodo de trabajo" data-i18n-aria-label="method.label">
          {
            methodSteps.map((step, index) => (
              <article class="method-card">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3 data-i18n={step.i18nKey ? `${step.i18nKey}.title` : undefined}>{step.title}</h3>
                <p data-i18n={step.i18nKey ? `${step.i18nKey}.detail` : undefined}>{step.detail}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section automize-principles">
        <div class="section-intro">
          <p class="eyebrow" data-i18n="principles.eyebrow">Automatizacion con control</p>
          <h2 data-i18n="principles.title">El punto no es automatizar todo, es automatizar sin perder control</h2>
          <p data-i18n="principles.body">
            Cada flujo debe tener limites claros: que se ejecuta solo, que vuelve a revision humana y como se detecta un
            error antes de que afecte al equipo.
          </p>
        </div>
        <CardGrid
          items={principles}
          gridClass="step-grid"
          cardClass="step-card"
          ariaLabel={languageCopy.es["principles.label"]}
          ariaLabelKey="principles.label"
        />
      </section>

      <section id="contacto" class="contact-section automize-contact">
        <div class="contact-copy">
          <p class="eyebrow" data-i18n="contact.eyebrow">Siguiente paso</p>
          <h2 data-i18n="contact.title">Cuentanos que proceso quieres dejar de perseguir a mano</h2>
          <p data-i18n="contact.body">
            No necesitamos accesos al inicio. Describe el flujo, las herramientas que usa el equipo y la salida
            esperada; si hay fit, definimos un diagnostico acotado.
          </p>
          <ul class="contact-points">
            <li data-i18n="contact.point.fit">Fit inicial antes de pedir accesos</li>
            <li data-i18n="contact.point.price">Diagnostico pagado desde USD 900</li>
            <li data-i18n="contact.point.discount">Descontable si avanzas a implementacion</li>
          </ul>
        </div>

        <LeadForm
          config={landingConfig}
          source="automize-landing"
          offer="workflow-automation-diagnostic"
          websiteLabel="Empresa o sitio web"
          websitePlaceholder="https://tuempresa.cl"
          symptomLabel="Proceso o tarea a diagnosticar"
          symptomPlaceholder="Ej: reportes manuales, correos repetitivos, planillas, solicitudes internas o seguimiento comercial"
        />
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-brand">
        <a class="footer-brand-link" href="#home" aria-label="Automize Solutions">
          <img class="footer-brand-mark" src="/automize-icon.png" alt="" width="40" height="40" />
          <strong>Automize Solutions</strong>
        </a>
        <p data-i18n="footer.description">
          Automatizacion, software y soluciones digitales para operar procesos repetidos con mas control.
        </p>
        <a class="footer-email" href="mailto:contacto@automize.cl">contacto@automize.cl</a>
      </div>

      <nav class="footer-nav" aria-label="Redes sociales" data-i18n-aria-label="footer.socialLabel">
        <h2 data-i18n="footer.socialTitle">Redes sociales</h2>
        <ul class="footer-links footer-social-links">
          <li>
            <a
              href="https://www.facebook.com/people/Automize-Solutions/61588897326307/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook de Automize Solutions">
              Facebook
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/company/automize-solutions/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn de Automize Solutions">
              LinkedIn
            </a>
          </li>
          <li>
            <span class="footer-link-disabled" aria-disabled="true">
              Instagram <small data-i18n="footer.comingSoon">Proximamente</small>
            </span>
          </li>
          <li>
            <span class="footer-link-disabled" aria-disabled="true">
              YouTube <small data-i18n="footer.comingSoon">Proximamente</small>
            </span>
          </li>
        </ul>
      </nav>

      <nav class="footer-nav" aria-label="Informacion legal" data-i18n-aria-label="footer.legalLabel">
        <h2 data-i18n="footer.legalTitle">Informacion legal</h2>
        <ul class="footer-links footer-legal-links">
          <li>
            <span class="footer-link-disabled" aria-disabled="true">
              <span data-i18n="footer.privacy">Privacidad</span>
              <small data-i18n="footer.inPreparation">En preparacion</small>
            </span>
          </li>
          <li>
            <span class="footer-link-disabled" aria-disabled="true">
              <span data-i18n="footer.terms">Terminos</span>
              <small data-i18n="footer.inPreparation">En preparacion</small>
            </span>
          </li>
          <li>
            <span class="footer-link-disabled" aria-disabled="true">
              <span data-i18n="footer.legalNotice">Aviso legal</span>
              <small data-i18n="footer.inPreparation">En preparacion</small>
            </span>
          </li>
          <li>
            <a href="#contacto" data-i18n="footer.commercialContact">Contacto comercial</a>
          </li>
        </ul>
      </nav>

      <p class="footer-copyright">
        &copy; {currentYear} Automize Solutions. <span data-i18n="footer.rights">Todos los derechos reservados.</span>
      </p>
    </footer>

    <script id="language-copy" type="application/json" set:html={languagePayload}></script>
    <script src="../scripts/landing.ts"></script>
  </body>
</html>
