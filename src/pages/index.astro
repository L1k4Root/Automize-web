---
import ContactSection from "../components/ContactSection.astro";
import HomeClientsSection from "../components/home/HomeClientsSection.astro";
import HomeExplainSection from "../components/home/HomeExplainSection.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeServicesSection from "../components/home/HomeServicesSection.astro";
import { landingConfig } from "../config/landing";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  titleKey="meta.title"
  descriptionKey="meta.description"
  currentPath="/"
  ctaHref="#contacto"
  footerContactHref="#contacto"
>
  <main class="home-redesign">
    <HomeHero />
    <HomeExplainSection />
    <HomeServicesSection />
    <HomeClientsSection />

    <ContactSection
      config={landingConfig}
      source="automize-home"
      offer="solucion-digital"
      compactOnMobile={true}
      variant="home"
      compactFields={true}
    />
  </main>
</BaseLayout>
