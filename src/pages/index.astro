          </li>
          <li>
            <a
              href="https://www.linkedin.com/company/automize-solutions/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn de Automize Solutions">
              LinkedIn
            </a>
          </li>
          <li>
            <a
              href="https://www.instagram.com/automize._/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram de Automize Solutions">
              Instagram
            </a>
          </li>
          <li>
            <span class="footer-link-disabled" aria-disabled="true">YouTube</span>
          </li>
        </ul>
      </nav>

      <nav class="footer-nav" aria-label="Información legal" data-i18n-aria-label="footer.legalLabel">
        <h2 data-i18n="footer.legalTitle">Información legal</h2>
        <ul class="footer-links footer-legal-links">
          <li>
            <span class="footer-link-disabled" aria-disabled="true">
              <span data-i18n="footer.privacy">Privacidad</span>
            </span>
          </li>
          <li>
            <span class="footer-link-disabled" aria-disabled="true">
              <span data-i18n="footer.terms">Términos</span>
            </span>
          </li>
          <li>
            <span class="footer-link-disabled" aria-disabled="true">
              <span data-i18n="footer.legalNotice">Aviso legal</span>
            </span>
          </li>
          <li>
            <a href="#contacto" data-i18n="footer.commercialContact">Contacto comercial</a>
