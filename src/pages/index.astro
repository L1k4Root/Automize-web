---
import CardGrid from "../components/CardGrid.astro";
import ContactSection from "../components/ContactSection.astro";
import FaqList from "../components/FaqList.astro";
import { landingConfig } from "../config/landing";
import { heroFlowSteps, heroSignals, problemFlow } from "../data/automize";
import BaseLayout from "../layouts/BaseLayout.astro";

const solutionBlocks = [
  {
    tag: "01",
    badge: "Visibilidad",
    title: "Dashboards operativos",
    detail: "Creamos paneles para ver estados, responsables, pendientes y alertas sin perseguir información por correo o planillas.",
    result: "Control diario sobre lo que está pasando",
  },
  {
    tag: "02",
    badge: "Ejecución",
    title: "Procesos recurrentes",
    detail: "Ordenamos tareas que se repiten todas las semanas: reportes, solicitudes, seguimiento comercial, registros o aprobaciones.",
    result: "Menos retrabajo y menos pasos invisibles",
  },
  {
    tag: "03",
    badge: "Automatización",
    title: "Sistemas automatizados",
    detail: "Conectamos formularios, páginas web, integraciones y tareas programadas para que la operación avance con menos intervención manual.",
    result: "Flujos funcionando con seguimiento claro",
  },
];

const featuredCases = [
  {
    question: "Implementación guiada de IA",
    answer: "Instalamos y configuramos herramientas como Codex, Claude o Anthropic para tareas concretas del equipo, con una guía simple de uso.",
  },
  {
    question: "Asesoría de herramientas digitales",
    answer: "Evaluamos qué herramientas conviene usar, cómo integrarlas al flujo actual y qué hábitos necesita el equipo para aprovecharlas.",
  },
  {
    question: "Automatización de seguimiento",
    answer: "Ordenamos leads, solicitudes o tickets para que cada caso tenga responsable, estado y próxima acción visible.",
  },
];

const methodBlocks = [
  {
    title: "Entender",
    detail: "Revisamos cómo funciona hoy el proceso, quién participa y dónde se pierde tiempo o seguimiento.",
  },
  {
    title: "Diseñar",
    detail: "Definimos una solución simple: flujo, herramientas, responsables, estados y puntos de control.",
  },
  {
    title: "Implementar",
    detail: "Construimos, medimos y ajustamos antes de ampliar el alcance o sumar más complejidad.",
  },
];
---

<BaseLayout
  titleKey="meta.title"
  descriptionKey="meta.description"
  currentPath="/"
  ctaHref="#contacto"
  footerContactHref="#contacto"
>
  <main>
    <section id="home" class="hero automize-hero">
      <div class="automate-visual" aria-label="Mapa visual de solicitud, flujo, seguimiento y resultado" data-i18n-aria-label="hero.visualLabel">
        <img class="automation-emblem" src="/automize-icon.png" alt="" width="220" height="220" />
        <div class="flow-map">
          <span
            class="flow-node node-input"
            aria-label="Solicitud: requerimientos, datos, formularios, correos o eventos que inician el flujo"
            tabindex="0"
            data-tooltip="Requerimientos, datos, formularios, correos o eventos que inician el flujo"
            data-i18n="hero.node.input"
            data-i18n-aria-label="hero.node.inputLabel"
            data-i18n-tooltip="hero.node.inputTooltip">Solicitud</span
          >
          <span class="flow-line line-one"></span>
          <span
            class="flow-node node-decision"
            aria-label="Flujo: pasos definidos, responsables y criterios para mover el proceso"
            tabindex="0"
            data-tooltip="Pasos definidos, responsables y criterios para mover el proceso"
            data-i18n="hero.node.decision"
            data-i18n-aria-label="hero.node.decisionLabel"
            data-i18n-tooltip="hero.node.decisionTooltip">Flujo</span
          >
          <span class="flow-line line-two"></span>
          <span
            class="flow-node node-output"
            aria-label="Seguimiento: estado visible, alertas, responsable y próxima acción"
            tabindex="0"
            data-tooltip="Estado visible, alertas, responsable y próxima acción"
            data-i18n="hero.node.output"
            data-i18n-aria-label="hero.node.outputLabel"
            data-i18n-tooltip="hero.node.outputTooltip">Seguimiento</span
          >
          <span class="flow-branch branch-alert"></span>
          <span
            class="flow-node node-review"
            aria-label="Resultado: proceso trazable, salida lista y registro operativo"
            tabindex="0"
            data-tooltip="Proceso trazable, salida lista y registro operativo"
            data-i18n="hero.node.review"
            data-i18n-aria-label="hero.node.reviewLabel"
            data-i18n-tooltip="hero.node.reviewTooltip">Resultado</span
          >
        </div>
        <div class="signal-stack">
          {
            heroSignals.map((signal) => (
              <div class={`automation-signal ${signal.tone}`}>
                <span data-i18n={signal.i18nKey ? `${signal.i18nKey}.label` : undefined}>{signal.label}</span>
                <strong data-i18n={signal.i18nKey ? `${signal.i18nKey}.value` : undefined}>{signal.value}</strong>
              </div>
            ))
          }
        </div>
      </div>

      <div class="hero-content automize-hero-content">
        <p class="eyebrow">Automatización para la operación diaria</p>
        <h1>
          <span>Automatización</span>
          <span>y soluciones digitales</span>
        </h1>
        <p class="hero-subtitle">
          Analizamos procesos repetitivos, identificamos cuellos de botella y construimos sistemas que mejoran la integración, reducen trabajo manual y permiten operar con mayor claridad.
        </p>
        <div class="hero-mobile-flow" aria-label="Ruta de trabajo">
          {
            heroFlowSteps.map((step, index) => (
              <article class="hero-mobile-step">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{step.title}</strong>
                <p>{step.detail}</p>
              </article>
            ))
          }
        </div>
        <div class="hero-actions" aria-label="Acciones principales">
          <a class="button button-primary" href="/diagnostico#contacto" data-track-click="automize_home_diagnostic_cta">
            Solicitar diagnóstico
          </a>
          <a class="button button-secondary" href="/casos-de-uso" data-track-click="automize_home_cases_cta">
            Ver casos de uso
          </a>
        </div>
        <p class="hero-commitment">Menos trabajo manual. Más seguimiento. Más control sobre la operación.</p>
        <div class="premium-strip" aria-label="Oferta resumida">
          <div class="premium-strip-header">
            <span>Propuesta de valor</span>
            <strong>Ordenamos procesos manuales con automatización, integración de herramientas y soluciones digitales</strong>
            <em>Con trazabilidad, control y visibilidad para la ejecución diaria</em>
          </div>
          <ul class="premium-strip-points" aria-label="Puntos clave de la propuesta">
            <li>Partimos desde el diagnóstico del proceso real</li>
            <li>Conectamos sistemas y canales que la empresa ya usa</li>
            <li>Medimos lo que integramos para detectar mejoras</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section method-section method-preview-section">
      <div class="section-intro">
        <p class="eyebrow">Cómo partimos</p>
        <h2>De un proceso manual a una solución operativa simple</h2>
        <p>Primero entendemos el flujo real. Después diseñamos una solución concreta y medible antes de ampliar el alcance.</p>
      </div>
      <CardGrid items={methodBlocks} gridClass="step-grid" cardClass="step-card" />
      <div class="section-cta section-cta-compact">
        <p>La meta no es sumar herramientas por sumar. Es ordenar cómo se ejecuta el trabajo diario.</p>
        <div class="section-cta-actions">
          <a class="button button-secondary" href="/como-trabajamos" data-track-click="automize_home_method_cta">
            Ver metodología
          </a>
        </div>
      </div>
    </section>

    <section class="section section-tight">
      <div class="section-intro">
        <p class="eyebrow">Diagnóstico operacional</p>
        <h2>Diagnostico de procesos críticos</h2>
        <p>
          La primera etapa busca entender cómo se mueve el trabajo, dónde se pierde seguimiento y qué puntos conviene ordenar antes de implementar una solución.
        </p>
      </div>
      <div class="problem-flow" aria-label="Explicación visual del problema operativo">
        {
          problemFlow.map((item, index) => (
            <article class={`problem-flow-step ${item.tone}`}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{item.label}</h3>
                <p>{item.detail}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section services-section services-preview-section">
      <div class="services-header">
        <p class="eyebrow">Bloques de solución</p>
        <h2>El problema no es el trabajo manual. Es perder control operativo.</h2>
        <p>
          Una operación necesita ver qué está pasando, qué se repite, qué está atrasado y qué puede ejecutarse con menos intervención manual.
        </p>
      </div>
      <div class="service-catalog">
        {
          solutionBlocks.map((service, index) => (
            <article class={`service-card service-card-${index + 1}`}>
              <div class="service-card-topline">
                <span>{service.tag}</span>
                <em class="service-badge">{service.badge}</em>
              </div>
              <h3>{service.title}</h3>
              <p>{service.detail}</p>
              <strong>{service.result}</strong>
            </article>
          ))
        }
      </div>
      <div class="section-cta section-cta-compact">
        <p>Revise las ofertas concretas y vea dónde conviene partir según el tipo de proceso.</p>
        <div class="section-cta-actions">
          <a class="button button-primary" href="/servicios" data-track-click="automize_home_services_cta">
            Ver servicios
          </a>
        </div>
      </div>
    </section>

    <section class="section use-cases-section">
      <div class="section-intro">
        <p class="eyebrow">Casos de uso</p>
        <h2>Casos de uso especializado</h2>
        <p>También apoyamos adopción de herramientas modernas cuando tienen un uso claro dentro de la operación.</p>
      </div>
      <div class="faq-list">
        <FaqList items={featuredCases} />
      </div>
      <div class="section-cta section-cta-compact">
        <p>Si su operación se parece a uno de estos casos, vale la pena revisar la biblioteca completa.</p>
        <div class="section-cta-actions">
          <a class="button button-primary" href="/casos-de-uso" data-track-click="automize_home_cases_library_cta">
            Ver casos de uso
          </a>
        </div>
      </div>
    </section>

    <ContactSection
      config={landingConfig}
      source="automize-home"
      offer="diagnostico-operativo"
      compactOnMobile={true}
    />
  </main>
</BaseLayout>
