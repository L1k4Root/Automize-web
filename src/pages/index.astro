---
import CardGrid from "../components/CardGrid.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import LeadForm from "../components/LeadForm.astro";
import { landingConfig } from "../config/landing";
import { heroFlowSteps, heroSignals, integrationLogos, methodSteps, principles, problems, services } from "../data/automatize";
import { languageCopy } from "../data/i18n";
import "../styles/global.css";

const metadata = {
  title: languageCopy.es["meta.title"],
  description: languageCopy.es["meta.description"],
};
const integrationLoop = [...integrationLogos, ...integrationLogos];
const languagePayload = JSON.stringify(languageCopy).replace(/</g, "\\u003c");
const headerCtaKey = landingConfig.isLeadCaptureConfigured ? "cta.headerConfigured" : "cta.headerUnconfigured";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={metadata.description}
      data-i18n-content="meta.description"
    />
    <link rel="icon" type="image/png" href="/automatize-icon.png" />
    <link rel="apple-touch-icon" href="/automatize-icon.png" />
    <meta name="theme-color" content="#07110f" />
    <title>{metadata.title}</title>
  </head>
  <body class="automatize-page">
    <header class="site-header automatize-header" data-nav>
      <a class="brand" href="#home" aria-label="Automize">
        <img class="brand-mark" src="/automatize-icon.png" alt="" width="48" height="48" />
        <span class="brand-copy">
          <strong>Automize</strong>
          <small data-i18n="brand.subtitle">Diagnostico de automatizacion</small>
        </span>
      </a>
      <nav class="nav-links" aria-label="Navegacion principal" data-i18n-aria-label="nav.label">
        <a href="#problema" data-i18n="nav.problem">Problema</a>
        <a href="#servicios" data-i18n="nav.services">Servicios</a>
        <a href="#metodo" data-i18n="nav.method">Metodo</a>
        <a href="#contacto" data-i18n="nav.contact">Contacto</a>
      </nav>
      <div class="header-actions">
        <LanguageSwitch />
        <a class="header-cta" href="#contacto" data-track-click="automatize_header_cta" data-i18n={headerCtaKey}>
          {landingConfig.isLeadCaptureConfigured ? "Solicitar diagnostico" : "Preparar diagnostico"}
        </a>
      </div>
    </header>

    <main>
      <section id="home" class="hero automatize-hero">
        <div class="automate-visual" aria-label="Mapa visual de un workflow automatizado" data-i18n-aria-label="hero.visualLabel">
          <img class="automation-emblem" src="/automatize-icon.png" alt="" width="220" height="220" />
          <div class="flow-map">
            <span
              class="flow-node node-input"
              aria-label="Input: datos, formularios, correos, planillas o eventos que inician el flujo"
              tabindex="0"
              data-tooltip="Datos, formularios, correos, planillas o eventos que inician el flujo"
              data-i18n="hero.node.input"
              data-i18n-aria-label="hero.node.inputLabel"
              data-i18n-tooltip="hero.node.inputTooltip">Input</span
            >
            <span class="flow-line line-one"></span>
            <span
              class="flow-node node-decision"
              aria-label="Decision: reglas, IA o revision humana segun el riesgo"
              tabindex="0"
              data-tooltip="Reglas, IA o revision humana segun el riesgo"
              data-i18n="hero.node.decision"
              data-i18n-aria-label="hero.node.decisionLabel"
              data-i18n-tooltip="hero.node.decisionTooltip">Decision</span
            >
            <span class="flow-line line-two"></span>
            <span
              class="flow-node node-output"
              aria-label="Output: CRM actualizado, alerta enviada, reporte creado o tarea asignada"
              tabindex="0"
              data-tooltip="CRM actualizado, alerta enviada, reporte creado o tarea asignada"
              data-i18n="hero.node.output"
              data-i18n-aria-label="hero.node.outputLabel"
              data-i18n-tooltip="hero.node.outputTooltip">Output</span
            >
            <span class="flow-branch branch-alert"></span>
            <span
              class="flow-node node-review"
              aria-label="Revision: control humano para excepciones, errores o decisiones sensibles"
              tabindex="0"
              data-tooltip="Control humano para excepciones, errores o decisiones sensibles"
              data-i18n="hero.node.review"
              data-i18n-aria-label="hero.node.reviewLabel"
              data-i18n-tooltip="hero.node.reviewTooltip">Revision</span
            >
          </div>
          <div class="signal-stack">
            {
              heroSignals.map((signal) => (
                <div class={`automation-signal ${signal.tone}`}>
                  <span data-i18n={signal.i18nKey ? `${signal.i18nKey}.label` : undefined}>{signal.label}</span>
                  <strong data-i18n={signal.i18nKey ? `${signal.i18nKey}.value` : undefined}>{signal.value}</strong>
                </div>
              ))
            }
          </div>
        </div>

        <div class="hero-content automatize-hero-content">
          <p class="eyebrow" data-i18n="hero.eyebrow">Automatizacion de procesos, IA e integraciones</p>
          <h1 data-i18n="hero.title">Automatizacion, IA y workflows para operar con menos trabajo manual</h1>
          <p class="hero-subtitle" data-i18n="hero.subtitle">
            Disenamos e implementamos flujos que conectan tus herramientas, reducen tareas repetidas y dejan trazabilidad
            para que el equipo pueda operar con mas control.
          </p>
          <div class="hero-mobile-flow" aria-label="Ruta del diagnostico" data-i18n-aria-label="hero.mobileFlowLabel">
            {
              heroFlowSteps.map((step, index) => (
                <article class="hero-mobile-step">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <strong data-i18n={step.i18nKey ? `${step.i18nKey}.title` : undefined}>{step.title}</strong>
                  <p data-i18n={step.i18nKey ? `${step.i18nKey}.detail` : undefined}>{step.detail}</p>
                </article>
              ))
            }
          </div>
          <div class="hero-actions" aria-label="Acciones principales">
            <a class="button button-primary" href="#contacto" data-track-click="automatize_lead_cta" data-i18n="hero.primaryCta">
              Solicitar diagnostico
            </a>
            <a class="button button-secondary" href="#servicios" data-track-click="automatize_services_cta" data-i18n="hero.secondaryCta">
              Ver servicios
            </a>
          </div>
          <p class="hero-commitment" data-i18n="hero.commitment">
            Partimos con un diagnostico pagado y lo descontamos si avanzas a implementacion
          </p>
          <div class="premium-strip" aria-label="Oferta resumida">
            <span data-i18n="hero.offerLabel">Diagnostico pagado</span>
            <strong data-i18n="hero.offerDetail">Mapa, prioridad y plan de implementacion</strong>
            <em data-i18n="hero.offerPrice">Desde USD 900</em>
          </div>
        </div>
      </section>

      <section class="integration-strip" aria-label="Apps con las que trabajamos">
        <div class="integration-copy">
          <p class="eyebrow" data-i18n="integrations.label">Apps con las que trabajamos</p>
          <h2 data-i18n="integrations.title">Conectamos lo que ya usas para que el flujo no dependa de copiar y pegar</h2>
        </div>
        <div class="integration-carousel" aria-hidden="true">
          <div class="integration-track">
            {
              integrationLoop.map((logo) => (
                <span class={`integration-logo ${logo.tone}`}>
                  <span class="integration-logo-mark">
                    {
                      logo.logoUrl ? (
                        <img
                          src={logo.logoUrl}
                          alt={logo.logoAlt ?? logo.name}
                          loading="lazy"
                          decoding="async"
                          width="28"
                          height="28"
                        />
                      ) : (
                        <strong>{logo.mark}</strong>
                      )
                    }
                  </span>
                  <em>{logo.name}</em>
                </span>
              ))
            }
          </div>
        </div>
      </section>

      <section id="problema" class="section section-tight">
        <div class="section-intro">
          <p class="eyebrow" data-i18n="problems.eyebrow">Problemas que resolvemos</p>
          <h2 data-i18n="problems.title">Trabajo manual que frena ventas, soporte y administracion</h2>
          <p>
            <strong class="brand-inline" data-i18n="problems.bodyPrefix">Automize</strong>{" "}
            <span data-i18n="problems.body">convierte pasos repetidos en flujos conectados: captura datos, actualiza herramientas, avisa al responsable y deja registro.</span>
          </p>
        </div>
        <CardGrid
          items={problems}
          gridClass="automatize-problem-grid"
          cardClass="scope-card"
          ariaLabel={languageCopy.es["problems.gridLabel"]}
          ariaLabelKey="problems.gridLabel"
        />
      </section>

      <section class="section services-section">
        <span id="servicios" class="section-scroll-target" aria-hidden="true"></span>
        <div class="services-header">
          <p class="eyebrow" data-i18n="services.eyebrow">Servicios</p>
          <h2 data-i18n="services.title">Un catalogo simple para avanzar sin sobredisenar</h2>
          <p data-i18n="services.body">
            Puedes partir por diagnostico, construir un flujo concreto o mantener un plan mensual para mejorar lo que ya
            esta funcionando.
          </p>
        </div>
        <div class="services-visual" aria-label="Servicios de Automize" data-i18n-aria-label="services.visualLabel">
          <div class="service-catalog">
            {
              services.map((service, index) => (
                <article class={`service-card service-card-${index + 1}`}>
                  <span>{service.tag}</span>
                  <h3 data-i18n={service.i18nKey ? `${service.i18nKey}.title` : undefined}>{service.title}</h3>
                  <p data-i18n={service.i18nKey ? `${service.i18nKey}.detail` : undefined}>{service.detail}</p>
                  {service.result && <strong data-i18n={service.i18nKey ? `${service.i18nKey}.result` : undefined}>{service.result}</strong>}
                </article>
              ))
            }
          </div>
          <div class="service-diagram" aria-label="Flujo de decision de servicios" data-i18n-aria-label="services.diagramLabel">
            <span class="diagram-pill" data-i18n="services.diagram.diagnostic">Diagnostico</span>
            <span class="diagram-line"></span>
            <span class="diagram-pill highlight" data-i18n="services.diagram.build">Build</span>
            <span class="diagram-line danger"></span>
            <span class="diagram-pill" data-i18n="services.diagram.growth">Growth</span>
            <p data-i18n="services.diagram.body">Primero elegimos bien. Luego construimos. Despues medimos, corregimos y ampliamos.</p>
          </div>
        </div>
      </section>

      <section id="metodo" class="section method-section">
        <div class="section-intro">
          <p class="eyebrow" data-i18n="method.eyebrow">Metodo</p>
          <h2 data-i18n="method.title">Trabajamos sobre puntos criticos, rendimiento y mejora real</h2>
          <p data-i18n="method.body">
            El metodo no es llenar la empresa de automatizaciones. Es encontrar donde duele, construir algo liviano y
            optimizarlo con datos de uso.
          </p>
        </div>
        <div class="method-timeline" aria-label="Metodo de trabajo" data-i18n-aria-label="method.label">
          {
            methodSteps.map((step, index) => (
              <article class="method-card">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3 data-i18n={step.i18nKey ? `${step.i18nKey}.title` : undefined}>{step.title}</h3>
                <p data-i18n={step.i18nKey ? `${step.i18nKey}.detail` : undefined}>{step.detail}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section automatize-principles">
        <div class="section-intro">
          <p class="eyebrow" data-i18n="principles.eyebrow">Automatizacion con control</p>
          <h2 data-i18n="principles.title">El punto no es automatizar todo, es automatizar sin perder control</h2>
          <p data-i18n="principles.body">
            Cada flujo debe tener limites claros: que se ejecuta solo, que vuelve a revision humana y como se detecta un
            error antes de que afecte al equipo.
          </p>
        </div>
        <CardGrid
          items={principles}
          gridClass="step-grid"
          cardClass="step-card"
          ariaLabel={languageCopy.es["principles.label"]}
          ariaLabelKey="principles.label"
        />
      </section>

      <section id="contacto" class="contact-section automatize-contact">
        <div class="contact-copy">
          <p class="eyebrow" data-i18n="contact.eyebrow">Siguiente paso</p>
          <h2 data-i18n="contact.title">Cuentanos que proceso te esta frenando</h2>
          <p data-i18n="contact.body">
            Comparte que tarea se repite, que herramientas usa el equipo y que salida necesitas. Si calza, se define un
            diagnostico acotado.
          </p>
          <ul class="contact-points">
            <li data-i18n="contact.point.fit">Fit inicial antes de pedir accesos</li>
            <li data-i18n="contact.point.price">Diagnostico pagado desde USD 900</li>
            <li data-i18n="contact.point.discount">Descontable si avanzas a implementacion</li>
          </ul>
        </div>

        <LeadForm
          config={landingConfig}
          source="automize-landing"
          offer="workflow-automation-diagnostic"
          websiteLabel="Empresa o sitio web"
          websitePlaceholder="https://tuempresa.cl"
          symptomLabel="Proceso o tarea a diagnosticar"
          symptomPlaceholder="Ej: reportes manuales, correos repetitivos, planillas, solicitudes internas o seguimiento comercial"
        />
      </section>
    </main>

    <script id="language-copy" type="application/json" set:html={languagePayload}></script>
    <script src="../scripts/landing.ts"></script>
  </body>
</html>
