---
import { languageCopy } from "../data/i18n";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const languagePayload = JSON.stringify(languageCopy).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/automize-icon.png" />
    <meta name="theme-color" content="#07110f" />
    <title>{title}</title>
  </head>
  <body class="automize-page dev-preview-page">
    <slot />
    <script id="language-copy" type="application/json" set:html={languagePayload}></script>
    <script src="../scripts/landing.ts"></script>
  </body>
</html>

<style is:global>
  .dev-preview-page {
    min-height: 100vh;
    background: #050b0d;
  }

  .dev-preview-stage {
    min-height: 100vh;
  }

  .dev-preview-stage-section {
    display: grid;
    align-content: center;
    padding-block: clamp(64px, 8vw, 104px);
  }

  .dev-preview-stage-header {
    padding: 16px;
  }

  .dev-preview-stage-footer {
    display: grid;
    align-content: end;
  }

  .dev-preview-page .dev-hero-diagram-only {
    display: block;
    width: min(980px, calc(100% - 40px));
    min-height: auto;
    margin: 0 auto;
    padding: clamp(48px, 6vw, 78px) 0;
    background: none;
    border-bottom: 0;
  }

  .dev-preview-page .dev-hero-diagram-only::before,
  .dev-preview-page .dev-hero-diagram-only::after {
    content: none;
  }

  .dev-preview-page .dev-hero-diagram-only .automate-visual {
    display: block;
    grid-column: auto;
    grid-row: auto;
    width: 100%;
    min-height: 520px;
  }
</style>
