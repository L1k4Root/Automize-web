---
import type { LandingConfig } from "../config/landing";

interface Props {
  config: LandingConfig;
  source?: string;
  offer?: string;
  compactOnMobile?: boolean;
  compactFields?: boolean;
}

const {
  config,
  source = "automize-landing",
  offer = "workflow-automation-review",
  compactOnMobile = false,
  compactFields = false,
} = Astro.props;
const formAction = config.isLeadCaptureConfigured ? config.leadFormAction : "#";
const buttonLabel = "Enviar proceso para revisión";
const buttonLabelKey = config.isLeadCaptureConfigured ? "form.submitConfigured" : "form.submitUnconfigured";
const formNote = config.isLeadCaptureConfigured
  ? "Sin spam. Solo una respuesta para confirmar fit y siguiente paso"
  : "Formulario en preparación. La captura queda bloqueada hasta activar el canal de respuesta";
const formNoteKey = config.isLeadCaptureConfigured ? "form.noteConfigured" : "form.noteUnconfigured";
---

<form
  class:list={[
    "lead-form",
    compactOnMobile && "lead-form-compact-mobile",
    compactFields && "lead-form-compact-fields",
  ]}
  action={formAction}
  method="post"
  data-lead-form
  data-lead-configured={String(config.isLeadCaptureConfigured)}
  data-form-provider={config.leadFormProvider}
  data-analytics-provider={config.analyticsProvider}
  data-submit-label={buttonLabel}
  data-i18n-submit-label={buttonLabelKey}
  novalidate
>
  <input type="hidden" name="source" value={source} />
  <input type="hidden" name="offer" value={offer} />
  <div class="form-honeypot" aria-hidden="true">
    <label>
      <span>Dejar vacío</span>
      <input name="company_fax" type="text" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <label>
    <span data-i18n="form.nameLabel">Nombre</span>
    <input name="name" type="text" autocomplete="name" placeholder="Tu nombre" data-i18n-placeholder="form.namePlaceholder" required />
  </label>

  <label>
    <span data-i18n="form.emailLabel">Email</span>
    <input name="email" type="email" autocomplete="email" placeholder="nombre@empresa.cl" data-i18n-placeholder="form.emailPlaceholder" required />
  </label>

  <label>
    <span data-i18n="form.companyLabel">Empresa</span>
    <input name="company" type="text" autocomplete="organization" placeholder="Nombre de la empresa" data-i18n-placeholder="form.companyPlaceholder" required />
  </label>

  <label class="form-field-optional form-field-industry">
    <span data-i18n="form.industryLabel">Rubro</span>
    <input name="industry" type="text" autocomplete="organization-title" placeholder="Ej: inmobiliaria, clínica, agencia, B2B" data-i18n-placeholder="form.industryPlaceholder" />
  </label>

  <label>
    <span data-i18n="form.symptomLabel">¿Qué proceso quieres ordenar?</span>
    <textarea
      name="symptom"
      rows="4"
      placeholder="Ej: seguimiento comercial, agenda, reportes, solicitudes internas o documentos repetitivos"
      data-i18n-placeholder="form.symptomPlaceholder"
      required></textarea>
  </label>

  <label class="form-field-optional form-field-tools">
    <span data-i18n="form.toolsLabel">¿Qué herramientas usan hoy?</span>
    <textarea
      name="tools"
      rows="2"
      placeholder="Ej: WhatsApp, email, Google Sheets, CRM, Notion, agenda o formularios"
      data-i18n-placeholder="form.toolsPlaceholder"></textarea>
  </label>

  <label class="form-field-optional form-field-impact">
    <span data-i18n="form.impactLabel">¿Qué pasa si ese proceso falla o se atrasa?</span>
    <textarea
      name="impact"
      rows="3"
      placeholder="Ej: se pierden leads, se atrasan respuestas, aumenta el retrabajo o nadie ve el estado"
      data-i18n-placeholder="form.impactPlaceholder"></textarea>
  </label>

  <button class="button button-primary form-button" type="submit">
    <span data-submit-copy data-i18n={buttonLabelKey}>{buttonLabel}</span>
    <span aria-hidden="true">-&gt;</span>
  </button>

  <p class="form-note" data-i18n={formNoteKey}>{formNote}</p>
  <p class="form-status" role="status" aria-live="polite" data-form-status></p>
</form>
