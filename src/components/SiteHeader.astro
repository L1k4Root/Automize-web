---
import LanguageSwitch from "./LanguageSwitch.astro";
import { landingConfig } from "../config/landing";
import { languageCopy } from "../data/i18n";

interface NavItem {
  href: string;
  key: string;
  label: string;
}

interface Props {
  currentPath: string;
  ctaHref: string;
}

const { currentPath, ctaHref } = Astro.props;

const homeHref = currentPath === "/" ? "#home" : "/";
const sectionHref = (hash: string) => (currentPath === "/" ? hash : `/${hash}`);

const navItems: NavItem[] = [
  { href: homeHref, key: "nav.home", label: languageCopy.es["nav.home"] },
  { href: sectionHref("#servicios"), key: "nav.services", label: languageCopy.es["nav.services"] },
  { href: sectionHref("#sobre-nosotros"), key: "nav.about", label: languageCopy.es["nav.about"] },
  { href: sectionHref("#clientes"), key: "nav.clients", label: languageCopy.es["nav.clients"] },
  { href: currentPath === "/" ? "#contacto" : ctaHref, key: "nav.contact", label: languageCopy.es["nav.contact"] },
];

const headerCtaKey = landingConfig.isLeadCaptureConfigured ? "cta.headerConfigured" : "cta.headerUnconfigured";
const headerCtaLabel = landingConfig.isLeadCaptureConfigured
  ? languageCopy.es["cta.headerConfigured"]
  : languageCopy.es["cta.headerUnconfigured"];
---

<header class="site-header automize-header" data-nav>
  <a class="brand" href="/" aria-label="Automize">
    <img class="brand-mark" src="/automize-icon.png" alt="" width="48" height="48" />
    <span class="brand-copy">
      <strong>Automize</strong>
      <small data-i18n="brand.subtitle">SOLUCIONES DIGITALES</small>
    </span>
  </a>
  <nav class="nav-links" aria-label="Navegación principal" data-i18n-aria-label="nav.label">
    {
      navItems.map((item) => (
        <a class:list={[(currentPath === item.href || (currentPath === "/" && item.key === "nav.home")) && "is-active"]} href={item.href} data-i18n={item.key}>
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="header-actions">
    <a class="header-cta" href={ctaHref} data-track-click="automize_header_cta" data-i18n={headerCtaKey}>
      {headerCtaLabel}
    </a>
    <LanguageSwitch />
  </div>
</header>
