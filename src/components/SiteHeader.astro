---
import LanguageSwitch from "./LanguageSwitch.astro";
import { landingConfig } from "../config/landing";
import { languageCopy } from "../data/i18n";

interface NavItem {
  href: string;
  key: string;
  label: string;
}

interface Props {
  currentPath: string;
  ctaHref: string;
}

const { currentPath, ctaHref } = Astro.props;

const navItems: NavItem[] = [
  { href: "/", key: "nav.home", label: languageCopy.es["nav.home"] },
  { href: "/servicios", key: "nav.services", label: languageCopy.es["nav.services"] },
  { href: "/agentes-ia", key: "nav.agents", label: languageCopy.es["nav.agents"] },
  { href: "/casos-de-uso", key: "nav.useCases", label: languageCopy.es["nav.useCases"] },
  { href: "/como-trabajamos", key: "nav.method", label: languageCopy.es["nav.method"] },
  { href: "/faq", key: "nav.faq", label: languageCopy.es["nav.faq"] },
];

const headerCtaKey = landingConfig.isLeadCaptureConfigured ? "cta.headerConfigured" : "cta.headerUnconfigured";
const headerCtaLabel = landingConfig.isLeadCaptureConfigured
  ? languageCopy.es["cta.headerConfigured"]
  : languageCopy.es["cta.headerUnconfigured"];
---

<header class="site-header automize-header" data-nav>
  <a class="brand" href="/" aria-label="Automize">
    <img class="brand-mark" src="/automize-icon.png" alt="" width="48" height="48" />
    <span class="brand-copy">
      <strong>Automize</strong>
      <small data-i18n="brand.subtitle">Diagnóstico operativo</small>
    </span>
  </a>
  <nav class="nav-links" aria-label="Navegación principal" data-i18n-aria-label="nav.label">
    {
      navItems.map((item) => (
        <a class:list={[currentPath === item.href && "is-active"]} href={item.href} data-i18n={item.key}>
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="header-actions">
    <LanguageSwitch />
    <a class="header-cta" href={ctaHref} data-track-click="automize_header_cta" data-i18n={headerCtaKey}>
      {headerCtaLabel}
    </a>
  </div>
</header>
