---
type LanguageOption = {
  code: "es" | "en";
  labelKey: string;
  shortLabel: string;
  initialActive?: boolean;
};

const options: LanguageOption[] = [
  {
    code: "es",
    labelKey: "language.es",
    shortLabel: "ES",
    initialActive: true,
  },
  {
    code: "en",
    labelKey: "language.en",
    shortLabel: "EN",
  },
];
---

<div class="language-switch" aria-label="Idioma" data-language-switch data-i18n-aria-label="language.group">
  <div class="language-menu language-menu-inline" role="listbox" aria-label="Idioma" data-language-menu data-i18n-aria-label="language.group">
    {
      options.map((option) => (
        <button
          class:list={["language-option", option.initialActive && "is-active"]}
          type="button"
          role="option"
          data-language-option={option.code}
          data-language-short-label={option.shortLabel}
          aria-selected={String(Boolean(option.initialActive))}
          data-i18n-aria-label={option.labelKey}
        >
          {option.shortLabel}
        </button>
      ))
    }
  </div>
</div>
