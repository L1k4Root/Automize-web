---
import LeadForm from "./LeadForm.astro";
import type { LandingConfig } from "../config/landing";

interface Props {
  config: LandingConfig;
  source?: string;
  offer?: string;
  compactOnMobile?: boolean;
}

const {
  config,
  source = "automize-landing",
  offer = "workflow-automation-review",
  compactOnMobile = true,
} = Astro.props;
---

<section id="contacto" class="contact-section automize-contact">
  <div class="contact-copy">
    <p class="eyebrow" data-i18n="contact.eyebrow">Siguiente paso</p>
    <h2 data-i18n="contact.title">Diagnóstico de Automatización</h2>
    <p data-i18n="contact.body">
      Antes de implementar herramientas y automatizaciones, identificamos dónde realmente existe una oportunidad de mejora.
    </p>
    <ul class="contact-points">
      <li data-i18n="contact.point.process">Proceso crítico a analizar</li>
      <li data-i18n="contact.point.map">Mapa del flujo actual</li>
      <li data-i18n="contact.point.bottlenecks">Cuellos de botella</li>
      <li data-i18n="contact.point.risks">Riesgos operacionales</li>
      <li data-i18n="contact.point.opportunities">Oportunidades de automatización</li>
      <li data-i18n="contact.point.recommendation">Recomendación de solución</li>
    </ul>
    <a
      class="inline-link contact-email-cta"
      href="mailto:contacto@automize.cl?subject=Quiero%20revisar%20un%20proceso%20automatizable"
      data-track-click="automize_email_cta"
      data-i18n="contact.emailCta">Escribir por email</a
    >
  </div>

  <LeadForm
    config={config}
    source={source}
    offer={offer}
    compactOnMobile={compactOnMobile}
  />
</section>
