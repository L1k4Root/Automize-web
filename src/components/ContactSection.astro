---
import LeadForm from "./LeadForm.astro";
import type { LandingConfig } from "../config/landing";

interface Props {
  config: LandingConfig;
  source?: string;
  offer?: string;
  compactOnMobile?: boolean;
  variant?: "default" | "home";
  compactFields?: boolean;
}

const {
  config,
  source = "automize-landing",
  offer = "workflow-automation-review",
  compactOnMobile = true,
  variant = "default",
  compactFields = false,
} = Astro.props;
---

<section id="contacto" class:list={["contact-section", "automize-contact", variant === "home" && "contact-section-home"]}>
  <div class="contact-copy">
    <p class="eyebrow" data-i18n="contact.eyebrow">CONTACTO</p>
    <h2 data-i18n="contact.title">Cuéntanos qué necesitas ordenar</h2>
    <p data-i18n="contact.body">Déjanos nombre, email y empresa. Te respondemos con un primer paso claro.</p>
    <a
      class="inline-link contact-email-cta"
      href="mailto:contacto@automize.cl?subject=Quiero%20revisar%20un%20proceso%20automatizable"
      data-track-click="automize_email_cta"
      data-i18n="contact.emailCta">Escribir por email</a
    >
  </div>

  <LeadForm
    config={config}
    source={source}
    offer={offer}
    compactOnMobile={compactOnMobile}
    compactFields={compactFields}
  />
</section>
