---
import Icon from "../Icon.astro";

const processInputs = [
  { icon: "asset", src: "/icons/whatsapp.svg", label: "WhatsApp" },
  { icon: "asset", src: "/icons/outlook.svg", label: "Correos" },
  { icon: "asset", src: "/icons/excel.svg", label: "Planillas Excel" },
  { icon: "asset", src: "/icons/google-forms.svg", label: "Formularios" },
] as const;

const processOutputs = [
  { icon: "bell", label: "Alertas priorizadas" },
  { icon: "square-check", label: "Tareas automáticas" },
  { icon: "bar-chart", label: "Dashboard en tiempo real" },
  { icon: "trending-up", label: "Seguimiento comercial" },
] as const;
---

<div class="automate-visual" aria-label="Sistema digital Automize" data-i18n-aria-label="hero.visualLabel">
  <div class="digital-system-panel" aria-hidden="true">
    <div class="digital-system-header">
      <span>Proceso de Digitalización</span>
      <em><span></span>Active</em>
    </div>

    <div class="digital-system-flow">
      <svg class="system-connector-svg system-connector-svg-desktop" viewBox="0 0 1000 360" preserveAspectRatio="none" aria-hidden="true">
        <path class="connector-line connector-left connector-top" d="M330 74 C388 74 408 132 456 156" pathLength="100" />
        <path class="connector-line connector-left connector-mid" d="M330 132 C384 132 412 154 456 170" pathLength="100" />
        <path class="connector-line connector-left connector-mid" d="M330 228 C384 228 412 206 456 190" pathLength="100" />
        <path class="connector-line connector-left connector-bottom" d="M330 286 C388 286 408 228 456 204" pathLength="100" />
        <path class="connector-comet connector-comet-left connector-comet-one" d="M330 74 C388 74 408 132 456 156" pathLength="100" />
        <path class="connector-comet connector-comet-left connector-comet-two" d="M330 132 C384 132 412 154 456 170" pathLength="100" />
        <path class="connector-comet connector-comet-left connector-comet-three" d="M330 228 C384 228 412 206 456 190" pathLength="100" />
        <path class="connector-comet connector-comet-left connector-comet-four" d="M330 286 C388 286 408 228 456 204" pathLength="100" />

        <path class="connector-line connector-right connector-top" d="M544 156 C592 132 612 74 670 74" pathLength="100" />
        <path class="connector-line connector-right connector-mid" d="M544 170 C588 154 616 132 670 132" pathLength="100" />
        <path class="connector-line connector-right connector-mid" d="M544 190 C588 206 616 228 670 228" pathLength="100" />
        <path class="connector-line connector-right connector-bottom" d="M544 204 C592 228 612 286 670 286" pathLength="100" />
        <path class="connector-comet connector-comet-right connector-comet-one" d="M544 156 C592 132 612 74 670 74" pathLength="100" />
        <path class="connector-comet connector-comet-right connector-comet-two" d="M544 170 C588 154 616 132 670 132" pathLength="100" />
        <path class="connector-comet connector-comet-right connector-comet-three" d="M544 190 C588 206 616 228 670 228" pathLength="100" />
        <path class="connector-comet connector-comet-right connector-comet-four" d="M544 204 C592 228 612 286 670 286" pathLength="100" />

        <circle class="connector-dot connector-anchor" cx="456" cy="180" r="4.8" />
        <circle class="connector-dot connector-anchor" cx="544" cy="180" r="4.8" />
        <circle class="connector-dot connector-node connector-node-one" cx="330" cy="74" r="3.8" />
        <circle class="connector-dot connector-node connector-node-two" cx="330" cy="132" r="3.8" />
        <circle class="connector-dot connector-node connector-node-three" cx="330" cy="228" r="3.8" />
        <circle class="connector-dot connector-node connector-node-four" cx="330" cy="286" r="3.8" />
        <circle class="connector-dot connector-node connector-node-one" cx="670" cy="74" r="3.8" />
        <circle class="connector-dot connector-node connector-node-two" cx="670" cy="132" r="3.8" />
        <circle class="connector-dot connector-node connector-node-three" cx="670" cy="228" r="3.8" />
        <circle class="connector-dot connector-node connector-node-four" cx="670" cy="286" r="3.8" />
      </svg>

      <svg class="system-connector-svg system-connector-svg-mobile" viewBox="0 0 320 380" preserveAspectRatio="none" aria-hidden="true">
        <path class="connector-line connector-left connector-top" d="M76 32 C76 72 132 92 148 136" pathLength="100" />
        <path class="connector-line connector-left connector-mid" d="M132 32 C132 72 148 96 156 136" pathLength="100" />
        <path class="connector-line connector-left connector-mid" d="M188 32 C188 72 172 96 164 136" pathLength="100" />
        <path class="connector-line connector-left connector-bottom" d="M244 32 C244 72 188 92 172 136" pathLength="100" />
        <path class="connector-comet connector-comet-left connector-comet-one" d="M76 32 C76 72 132 92 148 136" pathLength="100" />
        <path class="connector-comet connector-comet-left connector-comet-two" d="M132 32 C132 72 148 96 156 136" pathLength="100" />
        <path class="connector-comet connector-comet-left connector-comet-three" d="M188 32 C188 72 172 96 164 136" pathLength="100" />
        <path class="connector-comet connector-comet-left connector-comet-four" d="M244 32 C244 72 188 92 172 136" pathLength="100" />

        <path class="connector-line connector-right connector-top" d="M148 244 C132 288 76 308 76 348" pathLength="100" />
        <path class="connector-line connector-right connector-mid" d="M156 244 C148 284 132 308 132 348" pathLength="100" />
        <path class="connector-line connector-right connector-mid" d="M164 244 C172 284 188 308 188 348" pathLength="100" />
        <path class="connector-line connector-right connector-bottom" d="M172 244 C188 288 244 308 244 348" pathLength="100" />
        <path class="connector-comet connector-comet-right connector-comet-one" d="M148 244 C132 288 76 308 76 348" pathLength="100" />
        <path class="connector-comet connector-comet-right connector-comet-two" d="M156 244 C148 284 132 308 132 348" pathLength="100" />
        <path class="connector-comet connector-comet-right connector-comet-three" d="M164 244 C172 284 188 308 188 348" pathLength="100" />
        <path class="connector-comet connector-comet-right connector-comet-four" d="M172 244 C188 288 244 308 244 348" pathLength="100" />

        <circle class="connector-dot connector-anchor" cx="160" cy="136" r="4.6" />
        <circle class="connector-dot connector-anchor" cx="160" cy="244" r="4.6" />
        <circle class="connector-dot connector-node connector-node-one" cx="76" cy="32" r="3.6" />
        <circle class="connector-dot connector-node connector-node-two" cx="132" cy="32" r="3.6" />
        <circle class="connector-dot connector-node connector-node-three" cx="188" cy="32" r="3.6" />
        <circle class="connector-dot connector-node connector-node-four" cx="244" cy="32" r="3.6" />
        <circle class="connector-dot connector-node connector-node-one" cx="76" cy="348" r="3.6" />
        <circle class="connector-dot connector-node connector-node-two" cx="132" cy="348" r="3.6" />
        <circle class="connector-dot connector-node connector-node-three" cx="188" cy="348" r="3.6" />
        <circle class="connector-dot connector-node connector-node-four" cx="244" cy="348" r="3.6" />
      </svg>

      <div class="flow-chip flow-chip-left-top">mensaje</div>
      <div class="flow-chip flow-chip-left-mid">correo</div>
      <div class="flow-chip flow-chip-left-low">excel</div>
      <div class="flow-chip flow-chip-left-bottom">formulario</div>
      <div class="flow-chip flow-chip-right-top">alerta</div>
      <div class="flow-chip flow-chip-right-mid">tarea</div>
      <div class="flow-chip flow-chip-right-low">dashboard</div>
      <div class="flow-chip flow-chip-right-bottom">seguimiento</div>

      <div class="system-group system-group-input">
        <span class="system-label">Flujo actual</span>
        <ul class="system-item-list">
          {
            processInputs.map((item) => (
              <li>
                {"src" in item ? <img class="icon icon-asset" src={item.src} alt="" width="44" height="44" /> : <Icon name={item.icon} />}
                <span>{item.label}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="system-core">
        <div class="system-core-mark">
          <img src="/automize-icon.png" alt="" width="96" height="96" />
        </div>
        <strong>Automize</strong>
        <p>Captura <span>·</span> Ordena <span>·</span> Acciona</p>
      </div>

      <div class="system-group system-group-result">
        <span class="system-label">Flujo digitalizado</span>
        <ul class="system-item-list">
          {
            processOutputs.map((item) => (
              <li>
                <Icon name={item.icon} />
                <span>{item.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</div>
